# mcp-tool-gateway — every value here is optional; defaults run a local demo.
# Never commit a real .env.

# Where the SQLite store (catalog, users, secrets, audit) lives.
GATEWAY_DATA_DIR=./data

# Fernet key for secrets at rest. Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Left empty, a key is generated once and kept in GATEWAY_DATA_DIR/secret.key (demo only).
GATEWAY_SECRET_KEY=

# Calls per principal per minute (sliding window).
GATEWAY_RATE_LIMIT_PER_MIN=60

# Web panel
GATEWAY_PANEL_HOST=127.0.0.1
GATEWAY_PANEL_PORT=8600

# Identity the stdio MCP server acts as (must exist; `admin` is seeded in demo mode).
GATEWAY_MCP_PRINCIPAL=admin

# Seed demo users/roles on first start (admin/admin, analyst/analyst). Disable in real deployments.
GATEWAY_DEMO_SEED=true
